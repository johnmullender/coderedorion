# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Use the current Flash model listed in AI Studio
GEMINI_MODEL=gemini-2.5-flash
# Tiger Data (Tiger Cloud) service URL. Leave empty to run without a database.
DATABASE_URL=
# Google Maps Routes API key (bus directions, tried first). Leave empty to use the METRO schedule only.
GOOGLE_MAPS_API_KEY=
# ElevenLabs (kiosk voices + speech-to-text). Leave empty to use Chrome's built-in speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
# Telegram bot token from @BotFather (optional). Run `python telegram_bot.py` to answer on Telegram.
TELEGRAM_BOT_TOKEN=
